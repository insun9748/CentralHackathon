# 이 파일을 복사해서 backend/local.properties 로 저장하고, 메일로 받은 실제 값을 채워넣으세요.
# local.properties는 .gitignore에 등록되어 있어서 git에는 올라가지 않습니다.
# IntelliJ, VS Code, ./gradlew bootRun 등 어떤 방식으로 실행해도 backend/ 안에서 실행하면 자동으로 읽힙니다.

DB_URL=jdbc:mysql://localhost:3306/deotlog?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
